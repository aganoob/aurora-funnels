  "preset": "next-docker-caddy",
  "migrations": [
    "upgrade:latest",
    "meta-v2",
    "proxy-caddy-v1"
  ],
  "deploymentRequirements": {
    "buildEnvironment": [
      "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
    ],
