# Copy to .shipflow/deploy/production.env locally and to /etc/shipflow/production/production.env on the VM.
# Keep the populated file root-owned and mode 0600. Supply NPM_TOKEN only as a BuildKit secret.
PRODUCTION_IMAGE=REPLACE_WITH_IMMUTABLE_IMAGE_DIGEST
NEXT_PUBLIC_APP_URL=https://aurora-meal.maratz.dev
NEXT_PUBLIC_POSTHOG_KEY=REPLACE_WITH_POSTHOG_PROJECT_KEY
NEXT_PUBLIC_POSTHOG_HOST=REPLACE_WITH_POSTHOG_HOST
NEXT_PUBLIC_META_DATASET_ID=REPLACE_WITH_META_DATASET_ID
NEXT_PUBLIC_META_MODE=live
POSTHOG_PROJECT_API_KEY=REPLACE_WITH_POSTHOG_SERVER_KEY
META_CAPI_ACCESS_TOKEN=REPLACE_WITH_META_CAPI_ACCESS_TOKEN
STRIPE_PRICE_AURORA_MEAL_PLAN_ANNUAL=REPLACE_WITH_STRIPE_PRICE_ID
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
SHIPFLOW_DELIVERY_DRIVER=postgres
POSTGRES_DB=shipflow
POSTGRES_USER=shipflow
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
DATABASE_URL=postgresql://shipflow:REPLACE_WITH_GENERATED_SECRET@production-postgres:5432/shipflow
SHIPFLOW_DELIVERY_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET
